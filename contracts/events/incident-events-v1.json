{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.sre-agent.example/events/incident-events-v1.json",
  "title": "IncidentEventV1",
  "description": "A compact replayable SSE notification. Consumers refetch resources over REST.",
  "type": "object",
  "required": [
    "eventId",
    "type",
    "incidentId",
    "resourceId",
    "occurredAt",
    "version"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "type": "string",
      "enum": [
        "INCIDENT_CREATED",
        "INCIDENT_ACKNOWLEDGED",
        "INCIDENT_ASSIGNED",
        "INCIDENT_RESOLVED",
        "INCIDENT_REOPENED",
        "ALERT_FIRING",
        "ALERT_RESOLVED",
        "ALERT_CLASSIFIED",
        "RCA_RUN_CREATED",
        "RCA_RUN_STATUS_CHANGED",
        "RCA_REPORT_PUBLISHED",
        "MESSAGE_CREATED"
      ]
    },
    "incidentId": {
      "type": "string",
      "format": "uuid"
    },
    "resourceId": {
      "type": "string",
      "format": "uuid"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "summary": {
      "type": "string",
      "maxLength": 256
    }
  },
  "additionalProperties": false
}
