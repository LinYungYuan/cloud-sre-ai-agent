  "cards": [
    {
      "dot": "cyan",
      "title": "三個獨立部署套件",
      "items": [
        "frontend、backend、rca-worker 可獨立建置與發布",
        "contracts 只保存版本化 API、message 與資料庫契約",
        "套件不得互相匯入原始碼"
      ]
    },
    {
      "dot": "amber",
      "title": "可靠非同步邊界",
      "items": [
        "Incident、RCA work 與 Outbox event 在同一 PostgreSQL transaction 建立",
        "Backend 在 request transaction commit 後即時發布 Pub/Sub",
        "失敗事件由受保護的 Operator operations endpoint 明確補送"
      ]
    },
    {
      "dot": "emerald",
      "title": "Evidence-first RCA",
      "items": [
        "Worker 決定 endpoint、tool、scope、window 與 retry policy",
        "模型只能呼叫 run-scoped collect_evidence 與 read_evidence_chunk",
        "Root 只接收已驗證 observations 與 opaque evidence references"
      ]
    }
  ]
