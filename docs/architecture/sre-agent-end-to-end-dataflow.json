  "cards": [
    {
      "dot": "cyan",
      "title": "Durable 接收與派送",
      "items": [
        "Webhook 先完成 PostgreSQL commit",
        "Outbox 發布失敗可由 Operator API 補送",
        "dedup key 防止建立重複 RCA 工作"
      ]
    },
    {
      "dot": "rose",
      "title": "Evidence-first 安全分析",
      "items": [
        "Worker 固定 endpoint、tool、scope、window、query 與 retry policy",
        "Evidence 保存一次；chunks 由 structured JSON 重建",
        "Root 只接收 validated observations 與 opaque references"
      ]
    }
  ]
